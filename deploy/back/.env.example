# Copy to deploy/back/.env on back-vm and adjust for the private OCI network.

# Image published from the build host or registry.
BACKEND_IMAGE=news-pulse-backend:latest

# Bind only to the back-vm private IP reachable from front-vm.
# Do not use 0.0.0.0 for OCI deployment.
BACKEND_BIND_ADDRESS=10.0.2.30
BACKEND_HOST_PORT=8080

# Persistent SQLite volume on back-vm.
NEWS_PULSE_DATA_DIR=/opt/news-pulse/data
NEWS_PULSE_DB_PATH=/app/data/news-pulse.sqlite

# Spring runtime.
SPRING_PROFILES_ACTIVE=prod
TZ=Asia/Seoul

# Keep JVM options here if OCI VM memory needs tuning.
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75
