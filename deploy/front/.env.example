# Copy to deploy/front/.env on front-vm and adjust for the private OCI network.

# Image published from the build host or registry.
FRONTEND_IMAGE=news-pulse-frontend:latest

# Bind only to the front-vm private IP. Do not use 0.0.0.0 for OCI deployment.
FRONT_BIND_ADDRESS=10.0.1.20
FRONT_HOST_PORT=80

# back-vm private IP or private DNS name reachable from front-vm.
BACKEND_HOST=10.0.2.30
BACKEND_PORT=8080
